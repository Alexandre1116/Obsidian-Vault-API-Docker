# Copy to .env and protect it: chmod 600 .env
# The API key is the only credential for MCP and for the management API.

VAULT_PATH=/vault
VAULT_API_PORT=2768
VAULT_API_BIND=0.0.0.0
VAULT_API_KEY=
# Patterns are matched against the WHOLE command, and no shell is used: `ls *`
# allows `ls` with arguments, a bare `ls` allows only `ls` with none. With a list
# configured, arguments must stay inside the vault (no absolute paths, `~`,
# drive paths or `..`), self-executing flags (-exec, -delete, ...) are rejected,
# and the child gets a minimal environment, never VAULT_API_KEY. `*` = nothing
# is restricted. An allowlisted program still keeps its own capabilities: this is
# not a sandbox, the container is.
VAULT_API_ALLOWED_COMMANDS=ls *,stat *,grep *,wc *,head *,tail *,pdftotext *
VAULT_API_AUTO_UPDATE=false
VAULT_API_MANAGEMENT_AUTH=true

# Where the server is reachable from outside, used in image URLs.
# VAULT_API_HOST=vault.example.ts.net:2768

# Scan and read limits (bytes). These exist because one large media file read
# as UTF-8 text is enough to OOM a small container.
# VAULT_API_MAX_SCAN_FILE_BYTES=2097152
# VAULT_API_MAX_TEXT_BYTES=4194304
# VAULT_API_MAX_BINARY_BYTES=33554432
# VAULT_API_MAX_WALK_ENTRIES=20000
# VAULT_API_MAX_SCAN_TOTAL_BYTES=33554432

# Deleted files and folders go here, relative to the vault root.
# Set to empty string to delete permanently (previous behaviour).
VAULT_API_TRASH_DIR=.trash
